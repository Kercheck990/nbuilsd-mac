# ---------------------------------------------------------------
# Сервер
# ---------------------------------------------------------------
PORT=10150
NODE_ENV=development
# Публичный адрес сервера — нужен для ссылок возврата после оплаты
PUBLIC_URL=https://nftgrade.freesrv.com

# ---------------------------------------------------------------
# База данных — PostgreSQL на Supabase
# ---------------------------------------------------------------
# Supabase Dashboard → Settings → Database → Connection string.
# Сервер работает долго и держит свой pg.Pool (до 10 соединений),
# поэтому берите режим "Session pooler" (порт 5432) — он поддерживает
# обычные постоянные соединения. "Transaction pooler" (порт 6543)
# нужен только для serverless/edge-функций и здесь не подходит.
#
# Формат Session pooler:
# postgres://postgres.<project-ref>:130592opt@asdA@aws-0-<регион>.pooler.supabase.com:5432/postgres
#
# Локально без Supabase:
# postgres://nft:nft@localhost:5432/nft_grader
DATABASE_URL=postgres://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres
# Supabase всегда требует SSL
DATABASE_SSL=true

# ---------------------------------------------------------------
# JWT
# ---------------------------------------------------------------
# Сгенерируйте: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ
JWT_EXPIRES_IN=30d

# ---------------------------------------------------------------
# Почта (коды подтверждения)
# ---------------------------------------------------------------
# Любой SMTP: Gmail, Yandex, Mailgun, Postmark, Resend, SendGrid…
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=supportnftgrade@gmail.com
SMTP_PASS=ocfybpthiihxibiy
MAIL_FROM="NFT-Grader <supportnftgrade@gmail.com>"
# Если true и SMTP не настроен — код печатается в консоль (удобно в разработке)
MAIL_DEV_LOG=true

# ---------------------------------------------------------------
# Платежи
# ---------------------------------------------------------------
# Сколько монет даётся за 1 единицу валюты
COINS_PER_UNIT=100
CURRENCY=USD

# Stripe (карты) — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Crypto Pay (@CryptoBot в Telegram) — https://help.crypt.bot/crypto-pay-api
CRYPTO_PAY_TOKEN=
CRYPTO_PAY_ASSET=USDT
# Придумайте строку и укажите её же в настройках вебхука CryptoBot
CRYPTO_PAY_WEBHOOK_SECRET=

# Telegram Stars (оплата внутри бота)
TELEGRAM_BOT_TOKEN=